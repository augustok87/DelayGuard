{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/[[...path]].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tracking-refresh",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/delay-check",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/notification-dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/customer-sync",
      "schedule": "*/10 * * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
