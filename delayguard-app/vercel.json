{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{legal/**,public/app.html}"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "shop" }],
      "missing": [
        { "type": "query", "key": "embedded" },
        { "type": "query", "key": "id_token" }
      ],
      "destination": "/auth",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
