# =============================================================================
# DELAYGUARD ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Last Updated: October 23, 2025
#
# PRODUCTION STATUS: ✅ All 14 required variables configured in Vercel
# 
# This file serves as a TEMPLATE for local development only.
# For production, all variables are configured in Vercel Dashboard.
# 
# NEVER commit actual .env files to the repository!
# =============================================================================

# =============================================================================
# SHOPIFY AUTHENTICATION (4 variables) - CRITICAL
# =============================================================================
# Get these from: Shopify Partners Dashboard → Your App → API credentials

SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_products,read_customers

# Stable public app URL — used for the OAuth redirect URI (must exactly match
# the redirect URL allowlisted in the Partner Dashboard). NOT the per-deploy
# VERCEL_URL.
SHOPIFY_APP_URL=https://delayguard-api.vercel.app

# Frontend variable for App Bridge (must have REACT_APP_ prefix)
REACT_APP_SHOPIFY_API_KEY=your_api_key_here

# =============================================================================
# DATABASE (1 variable) - REQUIRED
# =============================================================================
# PostgreSQL connection string with SSL
# Format: postgresql://user:password@host:port/database?sslmode=require

DATABASE_URL=postgresql://user:password@host:port/database

# =============================================================================
# REDIS/QUEUE (3 variables) - REQUIRED
# =============================================================================
# Redis connection for caching and job queues
# Get from: Upstash.com → Your Database
# NOTE: Upstash requires TLS — use the rediss:// (double-s) scheme, not redis://.

REDIS_URL=rediss://user:password@host:port
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# =============================================================================
# EXTERNAL APIs (5 variables) - REQUIRED
# =============================================================================

# ShipEngine - Multi-carrier shipping tracking
# Get from: ShipEngine.com → API Keys
SHIPENGINE_API_KEY=your_shipengine_key_here

# SendGrid - Email notifications
# Get from: SendGrid.com → Settings → API Keys
SENDGRID_API_KEY=your_sendgrid_key_here

# SendGrid dynamic template for delay notifications (Launch WS-E, task E1).
# Create once with `npm run sendgrid:create-template` and paste the printed
# d-… ID here. REQUIRED in production — EmailService refuses to send delay
# emails without it (dev/test fall back to a placeholder).
SENDGRID_DELAY_TEMPLATE_ID=d-your_template_id_here

# From address on every delay notification (LAUNCH_PLAN R1). Must be an
# address SendGrid accepts as a verified Sender Identity — either on a
# domain you completed Sender Authentication for, or a Single Sender
# Verified address. REQUIRED in production; EmailService throws rather than
# send from a placeholder. This replaced a hardcoded `noreply@delayguard.app`
# — a domain the project never owned.
SENDGRID_FROM_EMAIL=noreply@your-authenticated-domain.com

# Twilio - SMS notifications
# Get from: Twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# =============================================================================
# RUNTIME CONFIGURATION - REQUIRED
# =============================================================================

NODE_ENV=development

# Cron authentication — /api/cron/* endpoints require
# `Authorization: Bearer ${CRON_SECRET}`. Vercel Cron sends this header
# automatically when CRON_SECRET is set on the project.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_long_random_secret_here

# =============================================================================
# AUTO-PROVIDED BY VERCEL (No manual configuration needed)
# =============================================================================
# VERCEL_URL - Automatically provided by Vercel
# PORT - Automatically provided by Vercel

# =============================================================================
# OPTIONAL: MONITORING (Not required for app submission)
# =============================================================================

# Sentry - Error tracking (optional)
# Get from: Sentry.io → Your Project → Client Keys
# SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# LOCAL DEVELOPMENT ONLY
# =============================================================================

PORT=3000
HOST=localhost

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# ✅ All 14 required variables are configured in Vercel (Oct 23, 2025)
# ✅ Variables are set for: Production, Preview, and Development environments
# ✅ All sensitive values are encrypted and masked in Vercel UI
